{
	"name": "ζωι",
	"author": "Author - Δρ.ΒοροΝ",
	"variables": {
		"fg": "#c8c2b8",
		"fg-dim": "#6b7a73",

		"bg": "#0f1714",

		"red": "#e51a28",
		"hot": "#f54920",
		"orange": "#f66e16",
		
		"gold": "#f6a702",
		"yellow": "#f5e702",
		"grass": "#98d609",
		
		"green": "#61aa06",
		"cyan": "#00987a",
		"blue": "#0058a4",
		
		"violet": "#54408f",
		"magenta": "#682783",
		"purple": "#8d2481",
		
		"pink": "#e7717d",

		"tint-blue": "#adcaff",
		"slate-blue": "#5b6ea6",  
		"steel-blue": "#6f85c7",
		
		"indigo": "#2e3650",
		"indigo-hard": "#3a4470"
	},

	"globals": {
		"foreground": "var(fg)",                                 // Текст
		"background": "var(bg)",                                 // Фон
		"caret": "var(fg)",                                      // Курсор

		"line_highlight": "var(fg-dim)",                         // Подсветка текущей строки в сайдбаре редактора

		"selection": "color(var(fg-dim) alpha(0.5))",            // Фон выделения
		"selection_border": "color(var(fg-dim) alpha(1))",       // Бордер выделения
		"inactive_selection": "var(indigo)",

		"accent": "var(orange)",

		"highlight": "var(orange)",                              // Бордер выделения сходств
		"find_highlight": "var(orange)",                         // Бордер выделения по поиску сходств
		"find_highlight_foreground": "var(bg)",                  // Фон выделения по поиску сходств

		"misspelling": "var(red)",

		"active_guide": "var(indigo)",
		"stack_guide": "color(var(indigo) alpha(0.4))",

		"brackets_options": "underline",
		"brackets_foreground": "color(var(fg) alpha(0.8))",

		"tags_options": "underline",
		"tags_foreground": "color(var(fg) alpha(0.5))"
	},

	"rules": [
		{
			"name": "Comment",
			"scope": "comment, punctuation.definition.comment",  // Комментарии
			"foreground": "color(var(fg-dim) alpha(0.5))",
			"font_style": "italic"
		},

		{
			"name": "String",
			"scope": "string",                                   // Строки
			"foreground": "var(green)",
		},
		{
			"name": "String escapes / regex",
			"scope": "constant.character.escape, constant.other.escape, string.regexp", // Строковые эскейп-коды
			"foreground": "var(grass)",
			"font_style": "bold italic"
		},

		{
			"name": "Numbers",
			"scope": "constant.numeric",                         // Цифры и числа
			"foreground": "var(gold)"
		},
		{
			"name": "Numeric suffix / unit",
			"scope": "storage.type.numeric",                     // Числовые суффиксы (например комплексные числа)
			"foreground": "var(yellow)",
			"font_style": "italic"
		},

		{
			"name": "Language constants",
			"scope": "constant.language, constant.other.boolean, constant.other.null", // Булевые типы и нулл 
			"foreground": "var(red)",
			"font_style": "italic"
		},
		{
			"name": "User constants",
			"scope": "constant.character, constant.other",
			"foreground": "var(fg)"
		},

		{
			"name": "Keywords",
			"scope": "keyword - keyword.operator, keyword.operator.word", // Ключевые слова
			"foreground": "var(fg)",
			"font_style": "bold"			
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",                         // Операторы
			"foreground": "var(steel-blue)"
		},

		{
			"name": "Storage",
			"scope": "storage",                                  // Операторы управления памятью
			"foreground": "var(indigo-hard)"
		},
		{
			"name": "Storage type",
			"scope": "storage.type",                             // Выделение памяти на декларацию
			"foreground": "var(fg-dim)"
		},

		{
			"name": "Types / classes",
			"scope": "entity.name.type, support.type, support.class", // Классы встроенных типов и структур данных
			"foreground": "var(cyan)"
		},

		{
			"name": "Entity name",
			"scope": "entity.name - (entity.name.section | entity.name.tag | entity.name.label)", // Декларация названия класса 
			"foreground": "var(purple)",
			"font_style": "bold"
		},

		{
			"name": "Function declaration",
			"scope": "entity.name.function",                     // Декларация названия функции
			"foreground": "var(violet)",
			"font_style": "bold"
		},
		{
			"name": "Function call",
			"scope": "variable.function, support.function, support.macro", // Вызов функции
			"foreground": "var(blue)"
		},

		{
			"name": "Variables",
			"scope": "variable, variable.other, variable.parameter", // Декларация названия переменных
			"foreground": "var(fg)"
		},
		{
			"name": "Member access",
			"scope": "variable.member, punctuation.accessor",    // Точка-разделитель для доступа к методам экземпляра
			"foreground": "var(fg-dim)",
			"font_style": "bold"
		},
		{
			"name": "Language variables",
			"scope": "variable.language",                        // Ссылка на себя в классе
			"foreground": "var(magenta)",
			"font_style": "italic"
		},

		{
			"name": "Annotations / decorators",
			"scope": "meta.annotation, punctuation.definition.annotation, variable.annotation", // Аннотации типов и вызов декораторов
			"foreground": "var(indigo-hard)"
		},

		{
			"name": "Punctuation general",
			"scope": "punctuation",                              // Кавычки
			"foreground": "var(fg-dim)"
		},
		{
			"name": "Punctuation separators",
			"scope": "punctuation.separator, punctuation.terminator", // Запятые и двоеточие
			"foreground": "var(fg-dim)"
		},
		{
			"name": "Punctuation sections",
			"scope": "punctuation.section",                      //Круглые, квадратные и фигурные скобки
			"foreground": "var(fg-dim)"
		},

		{
			"name": "Tags / HTML",
			"scope": "entity.name.tag",
			"foreground": "var(indigo-hard)"
		},
		{
			"name": "Tag attributes",
			"scope": "entity.other.attribute-name",
			"foreground": "color(var(fg) alpha(0.55))"
		},

		{
			"name": "YAML Key",
			"scope": "entity.name.tag.yaml",
			"foreground": "var(indigo-hard)"
		},
		{
			"name": "YAML String",
			"scope": "source.yaml string.unquoted",
			"foreground": "var(fg)"
		},

		{
			"name": "Invalid",
			"scope": "invalid",
			"foreground": "var(bg)",
			"background": "var(red)"
		},
		{
			"name": "Invalid deprecated",
			"scope": "invalid.deprecated",
			"foreground": "var(bg)",
			"background": "var(orange)"
		},
		{
			"name": "Message error",
			"scope": "message.error",
			"foreground": "var(red)"
		},

		{
			"name": "Markup headings",
			"scope": "markup.heading",
			"foreground": "var(fg)",
			"font_style": "bold"
		},
		{
			"name": "Markup heading punctuation",
			"scope": "markup.heading punctuation.definition.heading",
			"foreground": "var(indigo-hard)"
		},
		{
			"name": "Markup links",
			"scope": "string.other.link, markup.underline.link",
			"foreground": "var(indigo-hard)",
			"font_style": "underline"
		},
		{
			"name": "Markup bold",
			"scope": "markup.bold",
			"font_style": "bold"
		},
		{
			"name": "Markup italic",
			"scope": "markup.italic",
			"font_style": "italic"
		},
		{
			"name": "Markup underline",
			"scope": "markup.underline",
			"font_style": "underline"
		},
		{
			"name": "Markup code block",
			"scope": "markup.raw",
			"foreground": "var(fg)",
			"background": "color(var(indigo) alpha(0.35))"
		},
		{
			"name": "Markup inline code",
			"scope": "markup.raw.inline",
			"foreground": "var(fg)",
			"background": "color(var(indigo) alpha(0.45))"
		},
		{
			"name": "Markup HR / blockquote markers",
			"scope": "punctuation.definition.thematic-break, markup.quote punctuation.definition.blockquote, markup.list punctuation.definition.list_item",
			"foreground": "var(fg-dim)"
		},

		{
			"name": "Diff header",
			"scope": "meta.diff, meta.diff.header",
			"foreground": "var(fg-dim)"
		},
		{
			"name": "Diff deleted",
			"scope": "markup.deleted",
			"foreground": "var(red)"
		},
		{
			"name": "Diff inserted",
			"scope": "markup.inserted",
			"foreground": "var(green)"
		},
		{
			"name": "Diff changed",
			"scope": "markup.changed",
			"foreground": "var(orange)"
		},
		{
			"name": "Diff deleted background",
			"scope": "diff.deleted",
			"background": "color(var(red) alpha(0.18))",
			"foreground_adjust": "l(+ 5%)"
		},
		{
			"name": "Diff deleted char background",
			"scope": "diff.deleted.char",
			"background": "color(var(red) alpha(0.30))",
			"foreground_adjust": "l(+ 10%)"
		},
		{
			"name": "Diff inserted background",
			"scope": "diff.inserted",
			"background": "color(var(green) alpha(0.18))",
			"foreground_adjust": "l(+ 5%)"
		},
		{
			"name": "Diff inserted char background",
			"scope": "diff.inserted.char",
			"background": "color(var(green) alpha(0.30))",
			"foreground_adjust": "l(+ 10%)"
		},

		{
			"name": "Search match line numbers",
			"scope": "constant.numeric.line-number.match",
			"foreground": "var(indigo-hard)"
		},

		{
			"name": "CSS property names",
			"scope": "support.type.property-name",
			"foreground": "var(fg)"
		}
	]
}
